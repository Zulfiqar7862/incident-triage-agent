# Pick ONE provider. With no key set, the app runs an offline scripted policy
# so the UI, runtime, and tests still work end to end.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# LLM_PROVIDER=auto            # auto | anthropic | openai | scripted

# Guardrails and budgets (all optional)
# MAX_STEPS=25
# MAX_RUN_TOKENS=400000
# CONTEXT_BUDGET_TOKENS=24000
# TOOL_OUTPUT_MAX_CHARS=6000
# MIN_WRITE_CONFIDENCE=0.5
# DB_PATH=data/agent.db
