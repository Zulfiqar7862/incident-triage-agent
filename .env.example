# ---- Model (pick one; Gemini is the default when its key is set) ----
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash     # or a pinned/preview model id from ai.google.dev/gemini-api/docs/models
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite   # auto-used on primary 429/quota
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDER=auto                 # auto | gemini | anthropic | openai | scripted
# REQUIRE_LLM=true                  # fail at startup instead of falling back to the offline deterministic provider for CI and local development

# ---- Security ----
# Required before exposing the service beyond localhost. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# CORS_ORIGINS=http://localhost:3000   # comma-separated; empty = same-origin only
# MAX_REQUEST_BYTES=1048576

# ---- Cost estimate: set to your model's current per-million-token prices ----
# COST_IN_PER_MTOK=0.5
# COST_OUT_PER_MTOK=3.0

# ---- Guardrails and budgets (optional) ----
# MAX_STEPS=25
# MAX_RUN_TOKENS=400000
# MAX_CONCURRENT_RUNS=10
# CONTEXT_BUDGET_TOKENS=24000
# TOOL_OUTPUT_MAX_CHARS=6000
# MIN_WRITE_CONFIDENCE=0.5
# MEMORY_TTL_DAYS=30
# MAX_RUN_COST_USD=1.0
# MAX_IDENTICAL_TOOL_CALLS=3
# BUDGET_ALERT_RATIO=0.8
# OTLP_ENDPOINT=           # e.g. http://localhost:4318 — empty disables export

# ---- Operations ----
# DB_PATH=data/agent.db
# LOG_FORMAT=text                   # json in production
# LOG_LEVEL=INFO

# Persistence (optional). Empty DATABASE_URL → SQLite at DB_PATH.
# DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
# CHECKPOINT_DB_PATH=data/agent.checkpoints.db

# Langfuse (optional — no-op without both keys)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
